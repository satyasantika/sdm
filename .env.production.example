# Produksi SDM FKIP — salin ke .env di server (chmod 600). JANGAN commit .env. Tidak ada rahasia di berkas contoh ini.
APP_NAME="SDM FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal, STANDAR-TEKNIS §1b)
APP_KODE=sdm
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Subpath produksi (STANDAR-TEKNIS §2.4): APP_URL = ASSET_URL; aset dibangun dengan ASSET_URL yang sama.
APP_URL=https://supportfkip.unsil.ac.id/sdm
ASSET_URL=https://supportfkip.unsil.ac.id/sdm
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB native di host (dijangkau container lewat host.docker.internal). Buat DB dan pengguna khusus aplikasi.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_sdm
DB_USERNAME=sdm
DB_PASSWORD=

# Cookie sesi ber-path /sdm dan hanya HTTPS. TRUSTED_PROXIES = IP reverse proxy fakultas (bukan *).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/sdm
SESSION_COOKIE=sdm_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
TRUSTED_PROXIES=

CSP_MODE=report-only
MFA_AKTIF=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=sdm_cache_

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

# Surel keluar lewat SMTP fakultas
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

WHATSAPP_ENABLED=false
WHATSAPP_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_TOKEN=

# Docker (opsional)
WEB_PORT=8080
