APP_NAME="SDM FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal, STANDAR-TEKNIS §1b)
APP_KODE=sdm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080/sdm   # produksi: https://supportfkip.unsil.ac.id/sdm (STANDAR-TEKNIS §2.4)
ASSET_URL=${APP_URL}
TRUSTED_PROXIES=*                 # produksi: IP reverse proxy

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB native di host (STANDAR-TEKNIS §2 dan §3), dijangkau container lewat host.docker.internal.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_sdm
DB_USERNAME=sdm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Wajib true di produksi (HTTPS)
SESSION_SECURE_COOKIE=false
CSP_MODE=report-only
# 2FA/MFA panel admin: dimatikan sementara; true untuk mewajibkan super-admin & admin-kepegawaian
MFA_AKTIF=false
SESSION_PATH=/sdm
SESSION_COOKIE=sdm_session
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=sdm_cache_

MEMCACHED_HOST=127.0.0.1

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

WHATSAPP_ENABLED=false
WHATSAPP_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_TOKEN=

# --- Dilayani di sub-path (mis. https://supportfkip.unsil.ac.id/sdm) di belakang reverse proxy ---
# APP_URL=https://supportfkip.unsil.ac.id/sdm
# ASSET_URL=https://supportfkip.unsil.ac.id/sdm
# SESSION_PATH=/sdm
# SESSION_COOKIE=sdm_session
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=172.16.0.0/12
