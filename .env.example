APP_NAME="SDM FKIP Unsil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080/sdm   # produksi: https://supportfkip.unsil.ac.id/sdm (STANDAR-TEKNIS §2.4)
ASSET_URL=${APP_URL}
TRUSTED_PROXIES=*                 # produksi: IP reverse proxy

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Wajib true di produksi (HTTPS)
SESSION_SECURE_COOKIE=false
CSP_MODE=report-only
SESSION_PATH=/sdm
SESSION_COOKIE=sdm_session
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=sdm_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=sdm_
REDIS_DB=48
REDIS_CACHE_DB=49
REDIS_QUEUE_DB=50

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Port host Sail (ubah bila bentrok dengan layanan lain)
APP_PORT=80
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

WHATSAPP_ENABLED=false
WHATSAPP_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_TOKEN=

# --- Dilayani di sub-path (mis. https://supportfkip.unsil.ac.id/sdm) di belakang reverse proxy ---
# APP_URL=https://supportfkip.unsil.ac.id/sdm
# ASSET_URL=https://supportfkip.unsil.ac.id/sdm
# SESSION_PATH=/sdm
# SESSION_COOKIE=sdm_session
# SESSION_SECURE_COOKIE=true
# HORIZON_PATH=sdm/horizon
# TRUSTED_PROXIES=172.16.0.0/12
