includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - config/
        - database/
        - routes/
    tmpDir: storage/phpstan
    ignoreErrors:
        # Relasi Eloquent & HasFactory pada model domain tidak perlu anotasi generik penuh.
        -
            identifier: missingType.generics
            path: app/Models/*
